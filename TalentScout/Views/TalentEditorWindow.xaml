<Window x:Class="TalentScout.Views.TalentEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Редагування анкети" Width="620" Height="670" WindowStartupLocation="CenterOwner">
    <ScrollViewer><Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Анкета таланту" Style="{StaticResource PageTitle}"/><TextBlock Text="Оновіть дані та збережіть зміни" Style="{StaticResource Caption}"/></StackPanel><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="128" Height="128"><Ellipse.Fill><ImageBrush ImageSource="{Binding Photos[0].RelativePath, Converter={StaticResource PhotoPathToImageConverter}}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse><StackPanel Grid.Column="2"><Button Content="Змінити фото" Click="ChangePhoto_Click" HorizontalAlignment="Left"/><TextBlock Text="Головне фото профілю" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></Grid><StackPanel Grid.Row="4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ім’я" Style="{StaticResource Caption}"/><TextBox Text="{Binding FirstName}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Прізвище" Style="{StaticResource Caption}"/><TextBox Text="{Binding LastName}"/></StackPanel></Grid><TextBlock Text="Місто" Style="{StaticResource Caption}" Margin="0,10,0,3"/><TextBox Text="{Binding City}"/><TextBlock Text="Зріст, см" Style="{StaticResource Caption}" Margin="0,10,0,3"/><TextBox Text="{Binding HeightCm}"/><TextBlock Text="Телефон" Style="{StaticResource Caption}" Margin="0,10,0,3"/><TextBox Text="{Binding Phone}"/><TextBlock Text="Email" Style="{StaticResource Caption}" Margin="0,10,0,3"/><TextBox Text="{Binding Email}"/><TextBlock Text="Примітки" Style="{StaticResource Caption}" Margin="0,10,0,3"/><TextBox Text="{Binding Notes}" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/><Button Content="Зберегти зміни" Click="Save_Click" Margin="0,16,0,0"/></StackPanel></Grid></ScrollViewer>
</Window>
