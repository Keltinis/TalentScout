<UserControl x:Class="TalentScout.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="22" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="Доброго дня, менеджере" Style="{StaticResource PageTitle}" /><TextBlock Text="Огляд бази талантів і активних кастингів на сьогодні" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel>
            <Button Content="＋ Додати талант" Click="OpenTalents_Click" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <UniformGrid Grid.Row="2" Columns="3">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0"><Grid><StackPanel><TextBlock Text="ТАЛАНТИ В БАЗІ" Style="{StaticResource Caption}" FontWeight="SemiBold" /><TextBlock Text="{Binding TalentsCount}" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,2" /><TextBlock Text="реальних анкет" Foreground="{StaticResource SuccessBrush}" FontSize="12" /></StackPanel><Border HorizontalAlignment="Right" Width="42" Height="42" Background="#FFFBEAF2" CornerRadius="13"><TextBlock Text="♙" FontSize="23" Foreground="{StaticResource RoseBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
            <Border Style="{StaticResource Card}" Margin="6,0"><Grid><StackPanel><TextBlock Text="АКТИВНІ ПРОЄКТИ" Style="{StaticResource Caption}" FontWeight="SemiBold" /><TextBlock Text="{Binding ActiveProjectsCount}" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,2" /><TextBlock Text="відкриті до добору" Foreground="{StaticResource NavyBrush}" FontSize="12" /></StackPanel><Border HorizontalAlignment="Right" Width="42" Height="42" Background="#FFF1EEF9" CornerRadius="13"><TextBlock Text="▣" FontSize="20" Foreground="{StaticResource NavyBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
            <Border Style="{StaticResource Card}" Margin="12,0,0,0"><Grid><StackPanel><TextBlock Text="КАНДИДАТИ" Style="{StaticResource Caption}" FontWeight="SemiBold" /><TextBlock Text="{Binding CandidatesCount}" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,2" /><TextBlock Text="у кастинг-проєктах" Foreground="{StaticResource RoseBrush}" FontSize="12" /></StackPanel><Border HorizontalAlignment="Right" Width="42" Height="42" Background="#FFFFEEF6" CornerRadius="13"><TextBlock Text="↗" FontSize="23" Foreground="{StaticResource PinkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
        </UniformGrid>
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Grid.Column="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><TextBlock Text="Останні додані таланти" Style="{StaticResource SectionTitle}" /><Button Content="Усі таланти" Click="OpenTalents_Click" Style="{StaticResource OutlineButton}" Padding="11,6" HorizontalAlignment="Right" /></Grid>
                <StackPanel Grid.Row="2">
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="{StaticResource RoseBrush}" CornerRadius="19"><TextBlock Text="АМ" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="Анна Мельник" FontWeight="SemiBold" /><TextBlock Text="24 роки · Київ · 176 см" Style="{StaticResource Caption}" /></StackPanel><TextBlock Grid.Column="2" Text="сьогодні" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="{StaticResource NavyBrush}" CornerRadius="19"><TextBlock Text="ДК" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="Денис Коваль" FontWeight="SemiBold" /><TextBlock Text="29 років · Львів · актор" Style="{StaticResource Caption}" /></StackPanel><TextBlock Grid.Column="2" Text="вчора" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="{StaticResource SecondaryBrush}" CornerRadius="19"><TextBlock Text="СЛ" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="Софія Левченко" FontWeight="SemiBold" /><TextBlock Text="22 роки · Одеса · вокал" Style="{StaticResource Caption}" /></StackPanel><TextBlock Grid.Column="2" Text="7 лист." Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                </StackPanel>
            </Grid></Border>
            <Border Style="{StaticResource Card}" Grid.Column="2"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Найближчі події" Style="{StaticResource SectionTitle}" />
                <StackPanel Grid.Row="2"><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,13" Margin="0,0,0,13"><Grid><Border Width="42" Height="42" Background="#FFFBEAF2" CornerRadius="11" HorizontalAlignment="Left"><StackPanel VerticalAlignment="Center"><TextBlock Text="12" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" /><TextBlock Text="ЛИСТ" FontSize="8" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" /></StackPanel></Border><StackPanel Margin="54,0,0,0"><TextBlock Text="Проби: реклама соку" FontWeight="SemiBold" /><TextBlock Text="14:00 · студія «Focus»" Style="{StaticResource Caption}" /></StackPanel></Grid></Border><Border Padding="0,0,0,13"><Grid><Border Width="42" Height="42" Background="#FFF1EEF9" CornerRadius="11" HorizontalAlignment="Left"><StackPanel VerticalAlignment="Center"><TextBlock Text="15" Foreground="{StaticResource NavyBrush}" FontWeight="Bold" HorizontalAlignment="Center" /><TextBlock Text="ЛИСТ" FontSize="8" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" /></StackPanel></Border><StackPanel Margin="54,0,0,0"><TextBlock Text="Дедлайн: Кіно «Тиша»" FontWeight="SemiBold" /><TextBlock Text="Затвердити фінальний склад" Style="{StaticResource Caption}" /></StackPanel></Grid></Border></StackPanel>
            </Grid></Border>
        </Grid>
    </Grid>
</UserControl>
