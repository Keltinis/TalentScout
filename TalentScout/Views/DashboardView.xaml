<UserControl x:Class="TalentScout.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="22" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="Доброго дня, менеджере" Style="{StaticResource PageTitle}" /><TextBlock Text="Огляд бази талантів і активних кастингів на сьогодні" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel>
            <Button Content="＋ Додати талант" Click="OpenTalents_Click" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <UniformGrid Grid.Row="2" Columns="3">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0"><Grid><StackPanel><TextBlock Text="ТАЛАНТИ В БАЗІ" Style="{StaticResource Caption}" FontWeight="SemiBold" /><TextBlock Text="{Binding TalentsCountText}" Foreground="{StaticResource TextBrush}" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,2" /><TextBlock Text="реальних анкет" Foreground="{StaticResource SuccessBrush}" FontSize="12" /></StackPanel><Border HorizontalAlignment="Right" Width="42" Height="42" Background="{StaticResource AccentBrush}" CornerRadius="13"><TextBlock Text="♙" FontSize="23" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
            <Border Style="{StaticResource Card}" Margin="6,0"><Grid><StackPanel><TextBlock Text="АКТИВНІ ПРОЄКТИ" Style="{StaticResource Caption}" FontWeight="SemiBold" /><TextBlock Text="{Binding ActiveProjectsCountText}" Foreground="{StaticResource TextBrush}" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,2" /><TextBlock Text="відкриті до добору" Foreground="{StaticResource NavyBrush}" FontSize="12" /></StackPanel><Border HorizontalAlignment="Right" Width="42" Height="42" Background="{StaticResource AccentBrush}" CornerRadius="13"><TextBlock Text="▣" FontSize="20" Foreground="{StaticResource NavyBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
            <Border Style="{StaticResource Card}" Margin="12,0,0,0"><Grid><StackPanel><TextBlock Text="КАНДИДАТИ" Style="{StaticResource Caption}" FontWeight="SemiBold" /><TextBlock Text="{Binding CandidatesCountText}" Foreground="{StaticResource TextBrush}" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,2" /><TextBlock Text="у кастинг-проєктах" Foreground="{StaticResource RoseBrush}" FontSize="12" /></StackPanel><Border HorizontalAlignment="Right" Width="42" Height="42" Background="{StaticResource AccentBrush}" CornerRadius="13"><TextBlock Text="↗" FontSize="23" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
        </UniformGrid>
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Grid.Column="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><TextBlock Text="Останні додані таланти" Style="{StaticResource SectionTitle}" /><Button Content="Усі таланти" Click="OpenTalents_Click" Style="{StaticResource OutlineButton}" Padding="11,6" HorizontalAlignment="Right" /></Grid>
                <ItemsControl Grid.Row="2" ItemsSource="{Binding RecentTalents}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><Ellipse Width="38" Height="38"><Ellipse.Fill><ImageBrush ImageSource="{Binding Photos[0].RelativePath, Converter={StaticResource PhotoPathToImageConverter}}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse><StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding FirstName}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding LastName}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="4,0,0,0"/></StackPanel><TextBlock Style="{StaticResource Caption}"><Run Text="{Binding City}"/><Run Text=" · "/><Run Text="{Binding HeightCm, StringFormat={}{0} см}"/></TextBlock><TextBlock Text="{Binding SkillSummary}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SkillSummary}" Margin="0,2,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding CreatedUtc, StringFormat={}{0:dd.MM.yyyy}}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </Grid></Border>
            <Border Style="{StaticResource Card}" Grid.Column="2"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel><TextBlock Text="Найближчі події" Style="{StaticResource SectionTitle}" /><TextBlock Text="Події з дат зйомок у створених проєктах" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel>
                <ItemsControl Grid.Row="2" ItemsSource="{Binding UpcomingProjects}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,13" Margin="0,0,0,13"><Grid><Border Width="42" Height="42" Background="{StaticResource AccentBrush}" CornerRadius="11" HorizontalAlignment="Left"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ShootingDate, StringFormat={}{0:dd}}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" /><TextBlock Text="ПОДІЯ" FontSize="8" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" /></StackPanel></Border><StackPanel Margin="54,0,0,0"><TextBlock Text="НАЗВА ПРОЄКТУ" Style="{StaticResource Caption}"/><TextBlock Text="{Binding DisplayTitle}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" FontSize="15"/><TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"><Run Text="{Binding City}"/><Run Text=" · "/><Run Text="{Binding ShootingDate, StringFormat={}{0:dd.MM.yyyy}}"/></TextBlock></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate><ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><DataTrigger Binding="{Binding UpcomingProjects.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style></ItemsControl>
                <TextBlock Grid.Row="2" Text="Поки що немає запланованих подій. Додайте дату зйомки під час створення проєкту." TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding UpcomingProjects.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Grid></Border>
        </Grid>
    </Grid>
</UserControl>
