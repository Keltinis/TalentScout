<UserControl x:Class="TalentScout.Views.CastingBoardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Кастинг-дошка" Style="{StaticResource PageTitle}"/><TextBlock Text="Змінюйте етап кандидата: запрошений → проби → затверджений → резерв" Style="{StaticResource Caption}"/></StackPanel><Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="Проєкт:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/><ComboBox Width="260" ItemsSource="{Binding Projects}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedProject}"/></StackPanel><Button Content="↻" Command="{Binding LoadCommand}" Style="{StaticResource OutlineButton}" HorizontalAlignment="Right" Padding="10,6"/></Grid><ScrollViewer Grid.Row="2"><ItemsControl ItemsSource="{Binding Candidates}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Talent.FullName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Talent.City}" Style="{StaticResource Caption}"/></StackPanel><Border Grid.Column="1" Background="#FFFBEAF2" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/></Border><Button Grid.Column="2" Content="Наступний етап →" Command="{Binding DataContext.MoveNextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,6"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border></Grid>
</UserControl>
