<UserControl x:Class="TalentScout.Views.CastingBoardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Кастинг-дошка" Style="{StaticResource PageTitle}"/><TextBlock Text="Оберіть проєкт, перегляньте кандидатів і послідовно змінюйте їхній етап." Style="{StaticResource Caption}"/></StackPanel><Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><ComboBox Width="260" HorizontalAlignment="Left" ItemsSource="{Binding Projects}" DisplayMemberPath="DisplayTitle" SelectedItem="{Binding SelectedProject}"/><Button Content="↻ Оновити" Command="{Binding LoadCommand}" Style="{StaticResource OutlineButton}" HorizontalAlignment="Right" Padding="10,6"/></Grid><TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0"/><Grid Grid.Row="3" Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="КАНДИДАТ" Style="{StaticResource Caption}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="СТАТУС" Style="{StaticResource Caption}" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="ДІЯ" Style="{StaticResource Caption}" FontWeight="SemiBold"/></Grid><ScrollViewer Grid.Row="4"><ItemsControl ItemsSource="{Binding Candidates}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions><Ellipse Width="42" Height="42" VerticalAlignment="Center"><Ellipse.Fill><ImageBrush ImageSource="{Binding Talent.Photos[0].RelativePath, Converter={StaticResource PhotoPathToImageConverter}}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse><StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center"><TextBlock Text="{Binding Talent.FullName}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="14"/><TextBlock Style="{StaticResource Caption}"><Run Text="{Binding Talent.City}"/><Run Text=" · "/><Run Text="{Binding Talent.HeightCm, StringFormat={}{0} см}"/></TextBlock><TextBlock Text="{Binding Talent.SkillSummary}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Talent.SkillSummary}" Margin="0,2,0,0"/></StackPanel><Border Grid.Column="2" Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource PrimaryBrush}" FontSize="11"/></Border><Button Grid.Column="3" Content="{Binding NextStageLabel}" IsEnabled="{Binding CanMoveToNextStage}" Command="{Binding DataContext.MoveNextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="9,7" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border></Grid>
</UserControl>
