<UserControl x:Class="TalentScout.Views.TalentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Таланти" Style="{StaticResource PageTitle}" /><TextBlock Text="Додайте профіль, фото та навички — запис одразу збережеться у локальній базі" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Grid.Column="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><TextBlock Text="Анкети в базі" Style="{StaticResource SectionTitle}" /><Button Content="↻ Оновити" Command="{Binding LoadCommand}" Style="{StaticResource OutlineButton}" Padding="11,6" HorizontalAlignment="Right" /></Grid>
                <ScrollViewer Grid.Row="2"><ItemsControl ItemsSource="{Binding Talents}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="74" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions><Ellipse Width="42" Height="42"><Ellipse.Fill><ImageBrush ImageSource="{Binding Photos[0].RelativePath, Converter={StaticResource PhotoPathToImageConverter}}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="{Binding FullName}" FontWeight="SemiBold" /><TextBlock Text="{Binding City}" Style="{StaticResource Caption}" /><TextBlock Text="{Binding HeightCm, StringFormat={}{0} см}" Style="{StaticResource Caption}" /></StackPanel><Button Grid.Column="2" Content="Редагувати" Command="{Binding DataContext.EditTalentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource OutlineButton}" Padding="7,5" VerticalAlignment="Center"/><Button Grid.Column="3" Content="×" Command="{Binding DataContext.DeleteTalentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#FFF2DCE6" Foreground="{StaticResource PrimaryBrush}" Padding="8,5" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            </Grid></Border>
            <Border Style="{StaticResource Card}" Grid.Column="2"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Нова анкета" Style="{StaticResource SectionTitle}" /><TextBlock Text="Головне фото є обов’язковим" Foreground="{StaticResource RoseBrush}" FontSize="12" Margin="0,4,0,16" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ім’я" Style="{StaticResource Caption}" /><TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Прізвище" Style="{StaticResource Caption}" /><TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" /></StackPanel></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Місто" Style="{StaticResource Caption}" /><TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Зріст, см" Style="{StaticResource Caption}" /><TextBox Text="{Binding HeightCm, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" /></StackPanel></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Дата народження" Style="{StaticResource Caption}" /><DatePicker SelectedDate="{Binding BirthDate}" Margin="0,5,0,12" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Стать" Style="{StaticResource Caption}" /><ComboBox ItemsSource="{Binding Genders}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedGender}" Margin="0,5,0,12" /></StackPanel></Grid>
                <TextBlock Text="Колір волосся" Style="{StaticResource Caption}" /><Grid Margin="0,5,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding HairColors}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedHairColor}" /><ComboBox Grid.Column="2" ItemsSource="{Binding CustomHairColors}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCustomHairColor}" /></Grid>
                <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding NewHairColorName, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="2" Content="＋ Колір" Command="{Binding AddHairColorCommand}" Padding="9,6" /></Grid>
                <TextBlock Text="Навички" Style="{StaticResource Caption}" /><ItemsControl ItemsSource="{Binding SkillOptions}" Margin="0,5,0,6"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2,12,2" FontSize="12" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding NewSkillName, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="2" Content="＋ Навичка" Command="{Binding AddSkillCommand}" Padding="9,6" /></Grid>
                <TextBlock Text="Головне фото" Style="{StaticResource Caption}" /><Grid Margin="0,5,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Background="#FFFFFBFD" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10,9"><TextBlock Text="{Binding PhotoLabel}" TextTrimming="CharacterEllipsis" /></Border><Button Grid.Column="2" Content="Обрати фото" Command="{Binding ChoosePhotoCommand}" /></Grid>
                <Button Content="Зберегти анкету" Command="{Binding SaveTalentCommand}" /><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel></ScrollViewer></Border>
        </Grid>
    </Grid>
</UserControl>
