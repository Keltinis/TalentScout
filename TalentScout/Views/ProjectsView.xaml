<UserControl x:Class="TalentScout.Views.ProjectsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Кастинг-проєкти" Style="{StaticResource PageTitle}"/><TextBlock Text="Створюйте проєкти та наповнюйте їх кандидатами" Style="{StaticResource Caption}"/></StackPanel><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width=".9*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><ScrollViewer><StackPanel><TextBlock Text="Новий проєкт" Style="{StaticResource SectionTitle}"/><TextBlock Text="Назва" Style="{StaticResource Caption}" Margin="0,12,0,3"/><TextBox Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Клієнт" Style="{StaticResource Caption}" Margin="0,10,0,3"/><TextBox Text="{Binding Client,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Місто" Style="{StaticResource Caption}" Margin="0,10,0,3"/><TextBox Text="{Binding City,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Критерії: вік" Style="{StaticResource Caption}" Margin="0,10,0,3"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding MinimumAge,UpdateSourceTrigger=PropertyChanged}"/><TextBox Grid.Column="2" Text="{Binding MaximumAge,UpdateSourceTrigger=PropertyChanged}"/></Grid><TextBlock Text="Мінімальний зріст" Style="{StaticResource Caption}" Margin="0,10,0,3"/><TextBox Text="{Binding MinimumHeight,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Стать / волосся" Style="{StaticResource Caption}" Margin="0,10,0,3"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding RequiredGender}"/><ComboBox Grid.Column="2" ItemsSource="{Binding HairColors}" SelectedItem="{Binding RequiredHairColor}"/></Grid><TextBlock Text="Опис" Style="{StaticResource Caption}" Margin="0,10,0,3"/><TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" Height="55" TextWrapping="Wrap" AcceptsReturn="True"/><Button Content="Створити проєкт" Command="{Binding CreateCommand}" Margin="0,14,0,0"/><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></ScrollViewer></Border><Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="Усі проєкти" Style="{StaticResource SectionTitle}"/><Button Content="↻" Command="{Binding LoadCommand}" Style="{StaticResource OutlineButton}" HorizontalAlignment="Right" Padding="10,6"/></Grid><ScrollViewer Grid.Row="1" Margin="0,15,0,0"><ItemsControl ItemsSource="{Binding Projects}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10"><Grid><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Client}" Style="{StaticResource Caption}"/></StackPanel><Border HorizontalAlignment="Right" Background="#FFFBEAF2" CornerRadius="8" Padding="8,3"><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource SecondaryBrush}"/></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border></Grid></Grid>
</UserControl>
