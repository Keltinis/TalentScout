<UserControl x:Class="TalentScout.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Параметричний пошук" Style="{StaticResource PageTitle}"/><TextBlock Text="Знайдіть талант та одразу додайте його до кастинг-проєкту" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Критерії" Style="{StaticResource SectionTitle}"/><TextBlock Text="Стать" Style="{StaticResource Caption}" Margin="0,14,0,3"/><ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding SelectedGender}"/><TextBlock Text="Вік" Style="{StaticResource Caption}" Margin="0,10,0,3"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding MinimumAge,UpdateSourceTrigger=PropertyChanged}"/><TextBox Grid.Column="2" Text="{Binding MaximumAge,UpdateSourceTrigger=PropertyChanged}"/></Grid><TextBlock Text="Зріст, см" Style="{StaticResource Caption}" Margin="0,10,0,3"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding MinimumHeight,UpdateSourceTrigger=PropertyChanged}"/><TextBox Grid.Column="2" Text="{Binding MaximumHeight,UpdateSourceTrigger=PropertyChanged}"/></Grid><TextBlock Text="Колір волосся" Style="{StaticResource Caption}" Margin="0,10,0,3"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding HairColors}" SelectedItem="{Binding SelectedHairColor}"/><ComboBox Grid.Column="2" ItemsSource="{Binding CustomHairColors}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCustomHairColor}"/></Grid><Grid Margin="0,6,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding NewHairColorName,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="＋" Command="{Binding AddHairColorCommand}" Padding="10,6"/></Grid><TextBlock Text="Обов’язкові навички" Style="{StaticResource Caption}"/><ItemsControl ItemsSource="{Binding SkillOptions}" Margin="0,5,0,8"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" FontSize="12" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding NewSkillName,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="＋" Command="{Binding AddSkillCommand}" Padding="10,6"/></Grid><Button Content="Знайти збіги" Command="{Binding SearchCommand}"/></StackPanel></ScrollViewer></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Результати пошуку" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding ResultCaption}" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right"><TextBlock Text="Додати до проєкту" Style="{StaticResource Caption}" HorizontalAlignment="Right"/><ComboBox Width="230" ItemsSource="{Binding Projects}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedProject}" Margin="0,4,0,0"/></StackPanel></Grid><ScrollViewer Grid.Row="2"><ItemsControl ItemsSource="{Binding Results}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions><Border Width="39" Height="39" Background="{StaticResource NavyBrush}" CornerRadius="20"><TextBlock Text="{Binding FirstName}" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="{Binding FullName}" FontWeight="SemiBold"/><TextBlock Text="{Binding City}" Style="{StaticResource Caption}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding HeightCm,StringFormat={}{0} см}" Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button Grid.Column="3" Content="＋ До проєкту" Command="{Binding DataContext.AddCandidateCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,6"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
        </Grid>
    </Grid>
</UserControl>
